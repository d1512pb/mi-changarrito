# Configuración de desarrollo local; no contiene credenciales de producción.
ENVIRONMENT=development
SESSION_SECRET=dev-secret-cambia-esto
SEED_ON_START=false
# true: carga tianguis de SEDECO y ofertas sintéticas (is_demo). No crea cuentas. Ver docs/catalogo-demo.md
DEMO_CATALOG=false
DATABASE_URL=

PORT=8000
TZ=America/Mexico_City
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000,http://localhost:4321
MAX_SESSIONS_PER_USER=3
SESSION_TTL_DAYS=7
BCRYPT_ROUNDS=12

UPLOADS_DIR=uploads
MAX_PHOTO_MB=5
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_URL_TTL_SECONDS=300

# Opcional: crear el primer PRO si el correo todavía no existe.
PRO_EMAIL=
PRO_PASSWORD=
